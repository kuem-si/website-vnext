---
import Icon from "./ArchitectureIcon.astro";
import logo from "../../assets/brand/nexavia/Nexavia_Logo_Light.svg";
const cards = [
  {
    id: "devices",
    icon: "devices",
    title: "NAPRAVE IN SENZORJI",
    sub: "Števci · senzorji · telemetrija",
  },
  {
    id: "radio",
    icon: "radio",
    title: "POVEZLJIVOST",
    sub: "LoRaWAN · NB-IoT · wM-Bus · LAN",
  },
  {
    id: "systems",
    icon: "systems",
    title: "OBSTOJEČI SISTEMI",
    sub: "ERP · SCADA · GIS · zunanji viri",
  },
  {
    id: "api",
    icon: "api",
    title: "API-INTEGRACIJE",
    sub: "Standardni vmesniki",
  },
];
---

<section
  class="architecture"
  aria-label="Arhitektura rešitve: od podatka do odločitve"
>
  <div class="micro">OD PODATKA DO ODLOČITVE</div>
  <p class="sr-only">
    Naprave in senzorji prek povezljivosti v Nexavio. Ločena pot: obstoječi
    sistemi prek API-integracij v Nexavio. KAI je analitični sloj Nexavie. Iz
    Nexavie do odločitve in ukrepa. NOC spremlja vse sloje in ni postaja
    podatkovnega toka.
  </p>
  <div class="architecture-grid">
    <svg class="wires" aria-hidden="true"
      ><defs
        ><marker
          id="architecture-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto"
          ><path
            d="m2 1 4 4-4 4"
            fill="none"
            stroke="#156B75"
            stroke-width="1.5"></path></marker
        ></defs
      ><g class="monitor-links"></g><g class="data-links"></g><g class="packets"
      ></g></svg
    >
    {
      cards.map((card) => (
        <article class={`node ${card.id}`} data-node={card.id}>
          <>
            <Icon name={card.icon} />
            <strong>{card.title}</strong>
            <span>{card.sub}</span>
          </>
        </article>
      ))
    }
    <article class="node platform" data-node="platform">
      <div class="logo">
        <img src={logo.src} alt="Nexavia" width="1200" height="360" />
      </div>
      <strong>NEXAVIA</strong><span>Zajem · obdelava · prikaz</span>
      <div class="kai">
        <Icon name="kai" /><div>
          <strong>KAI</strong><span>Analitika · opozorila · priporočila</span>
        </div>
      </div>
    </article>
    <article class="node action" data-node="action">
      <Icon name="action" /><strong>ODLOČITEV IN UKREP</strong><span
        >Človek ali avtomatizacija</span
      >
    </article>
    <aside class="noc" data-node="noc">
      <Icon name="noc" /><div>
        <strong>NOC IN UPRAVLJANE STORITVE</strong><span
          >Nadzor naprav · povezljivosti · alarmov · podpora</span
        >
      </div><svg class="network" viewBox="0 0 260 40" aria-hidden="true"
        ><path d="M12 20h236" stroke="#7DB7AB"></path><g fill="#7DB7AB"
          ><circle cx="12" cy="20" r="7"></circle><circle cx="90" cy="20" r="7"
          ></circle><circle cx="248" cy="20" r="7"></circle></g
        ><g fill="#253238" stroke="#7DB7AB" stroke-width="2"
          ><path d="m50 12 8 8-8 8-8-8zM130 12l8 8-8 8-8-8zM210 12l8 8-8 8-8-8z"
          ></path></g
        ><circle cx="170" cy="20" r="9" fill="#E95D2A"></circle><text
          x="170"
          y="25"
          text-anchor="middle"
          fill="white"
          font-size="14">!</text
        ></svg
      ><small>STALEN NADZOR<br />CELOTNE REŠITVE</small>
    </aside>
  </div>
</section>
<style>
  .architecture {
    container-type: inline-size;
    color: #253238;
    position: relative;
    width: 100%;
  }
  .micro {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #156b75;
    margin-bottom: 24px;
  }
  .micro:before {
    content: "";
    width: 28px;
    height: 1px;
    background: #7db7ab;
  }
  .architecture-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr 1.38fr 1fr;
    grid-template-rows: auto auto auto;
    gap: 36px 28px;
  }
  .node {
    position: relative;
    z-index: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    text-align: center;
    background: white;
    border: 1px solid #a8c9ce;
    border-radius: 8px;
    padding: 18px 8px;
    box-shadow: 0 4px 16px #25323804;
  }
  .node > :global(svg) {
    width: 66px;
    height: 56px;
    color: #156b75;
    margin-bottom: 12px;
  }
  .architecture strong {
    display: block;
    font-size: 12px;
    line-height: 1.35;
  }
  .architecture span {
    display: block;
    font-size: 11px;
    line-height: 1.5;
    margin-top: 5px;
    color: #486f7c;
  }
  .devices {
    grid-area: 1/1;
  }
  .radio {
    grid-area: 1/2;
  }
  .systems {
    grid-area: 2/1;
  }
  .api {
    grid-area: 2/2;
  }
  .platform {
    grid-area: 1/3/3/4;
    align-self: start;
    padding: 20px 12px;
  }
  .action {
    grid-area: 1/4;
  }
  .logo {
    width: 100%;
    height: 74px;
    overflow: hidden;
    position: relative;
    margin-bottom: 10px;
  }
  .logo img {
    position: absolute;
    max-width: none;
    width: 190%;
    height: auto;
    left: -8%;
    top: -8%;
  }
  .platform > strong {
    font-size: 18px;
  }
  .kai {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #156b75;
    width: 100%;
    border-radius: 6px;
    padding: 18px 10px;
    margin-top: 20px;
    text-align: left;
    color: white;
  }
  .kai :global(svg) {
    width: 40px;
    flex-shrink: 0;
  }
  .kai strong {
    font-size: 20px;
  }
  .kai span {
    color: white;
  }
  .noc {
    grid-area: 3/1/4/5;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 16px;
    background: #253238;
    color: white;
    padding: 20px;
    border-radius: 8px;
    min-width: 0;
  }
  .noc > :global(svg:first-child) {
    width: 44px;
    flex-shrink: 0;
  }
  .noc span {
    color: #bdd4d9;
  }
  .network {
    flex: 1;
    min-width: 60px;
    max-width: 300px;
  }
  .noc small {
    font-size: 10px;
    line-height: 1.6;
    border-left: 1px solid #7db7ab;
    padding-left: 16px;
    margin-left: auto;
  }
  .wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  @container (min-width:1000px) {
    .architecture-grid {
      gap: 42px 54px;
    }
    .node {
      padding: 25px 12px;
    }
    .architecture strong {
      font-size: 16px;
    }
    .architecture span {
      font-size: 14px;
    }
    .node > :global(svg) {
      width: 90px;
      height: 70px;
    }
    .logo {
      height: 100px;
    }
    .platform > strong {
      font-size: 22px;
    }
    .kai {
      padding: 22px 16px;
    }
    .noc small {
      font-size: 12px;
    }
  }
  @container (max-width:650px) {
    .architecture-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 38px 24px;
      padding: 0 16px;
    }
    .devices {
      grid-area: 1/1;
    }
    .radio {
      grid-area: 2/1;
    }
    .systems {
      grid-area: 1/2;
    }
    .api {
      grid-area: 2/2;
    }
    .platform {
      grid-area: 3/1/4/3;
      justify-self: center;
      width: 100%;
      max-width: 360px;
    }
    .action {
      grid-area: 4/1/5/3;
      justify-self: center;
      width: 100%;
      max-width: 360px;
    }
    .noc {
      grid-area: 5/1/6/3;
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      padding: 18px 12px;
      gap: 12px;
    }
    .noc > div {
      flex: 1;
    }
    .network {
      grid-column: 1 / -1;
      width: 100%;
      max-width: none;
      height: 36px;
    }
    .noc small {
      grid-column: 1 / -1;
      font-size: 9px;
    }
    .node {
      padding: 16px 7px;
    }
    .architecture strong {
      font-size: 12px;
    }
    .architecture span {
      font-size: 12px;
    }
    .logo {
      width: 230px;
      height: 82px;
    }
    .kai {
      justify-content: center;
    }
    .micro {
      font-size: 10px;
    }
    .platform > strong {
      font-size: 20px;
    }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>(".architecture").forEach((root) => {
    const grid = root.querySelector<HTMLElement>(".architecture-grid")!;
    const svg = root.querySelector<SVGSVGElement>(".wires")!;
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    let visible = false;
    const ns = "http://www.w3.org/2000/svg";
    const make = (
      tag: string,
      attrs: Record<string, string>,
      parent: Element,
    ) => {
      const el = document.createElementNS(ns, tag);
      Object.entries(attrs).forEach(([k, v]) => el.setAttribute(k, v));
      parent.append(el);
      return el;
    };
    const draw = () => {
      const bounds = grid.getBoundingClientRect();
      const mobile = root.clientWidth <= 650;
      const box = (id: string) => {
        const r = root
          .querySelector<HTMLElement>(`[data-node="${id}"]`)!
          .getBoundingClientRect();
        return {
          x: r.x - bounds.x,
          y: r.y - bounds.y,
          w: r.width,
          h: r.height,
        };
      };
      const links = svg.querySelector(".data-links")!;
      const packets = svg.querySelector(".packets")!;
      const monitors = svg.querySelector(".monitor-links")!;
      links.replaceChildren();
      packets.replaceChildren();
      monitors.replaceChildren();
      const routes = [
        ["devices", "radio", 0],
        ["radio", "platform", 1.25],
        ["systems", "api", 1.25],
        ["api", "platform", 2.5],
        ["platform", "action", 2.5],
        ["platform", "action", 3.75],
      ] as const;
      routes.forEach(([from, to, delay], i) => {
        const a = box(from),
          b = box(to);
        let d: string;
        if (mobile) {
          const x = a.x + a.w / 2,
            y = a.y + a.h;
          const endX =
            to === "platform"
              ? b.x + b.w * (from === "radio" ? 0.28 : 0.72)
              : b.x + b.w / 2;
          const endY = b.y;
          const mid = (y + endY) / 2;
          d = `M${x} ${y}V${mid}H${endX}V${endY}`;
        } else {
          const x = a.x + a.w,
            y = from === "platform" ? b.y + b.h / 2 : a.y + a.h / 2;
          const endY = from === "api" ? b.y + b.h - 35 : y;
          d = `M${x} ${y}H${(x + b.x) / 2}V${endY}H${b.x}`;
        }
        if (i !== 5)
          make(
            "path",
            {
              d,
              fill: "none",
              stroke: "#156B75",
              "stroke-width": "1.7",
              "marker-end": "url(#architecture-arrow)",
            },
            links,
          );
        const size = mobile ? 6 : 8;
        const rect = make(
          "rect",
          {
            x: String(-size / 2),
            y: String(-size / 2),
            width: String(size),
            height: String(size),
            rx: "1",
            fill: "#E95D2A",
          },
          packets,
        );
        if (motion.matches) {
          if (i === 5) {
            rect.remove();
            return;
          }
          const p = make(
            "path",
            { d },
            document.createElementNS(ns, "g"),
          ) as SVGPathElement;
          const point = p.getPointAtLength(p.getTotalLength() * 0.5);
          rect.setAttribute("transform", `translate(${point.x} ${point.y})`);
        } else {
          rect.setAttribute("opacity", "0");
          make(
            "animateMotion",
            {
              path: d,
              dur: "6.5s",
              begin: `${delay}s`,
              repeatCount: "indefinite",
              keyPoints: "0;1;1",
              keyTimes: "0;0.16;1",
              calcMode: "linear",
            },
            rect,
          );
          make(
            "animate",
            {
              attributeName: "opacity",
              values: "0;1;1;0;0",
              keyTimes: "0;0.02;0.14;0.16;1",
              dur: "6.5s",
              begin: `${delay}s`,
              repeatCount: "indefinite",
            },
            rect,
          );
        }
      });
      const noc = box("noc");
      ["devices", "radio", "api", "platform"].forEach((id) => {
        const a = box(id);
        let d: string;
        if (mobile) {
          const left = id === "devices" || id === "radio";
          const side = left ? 5 : bounds.width - 5;
          d = `M${a.x + (left ? 0 : a.w)} ${a.y + a.h * 0.7}H${side}V${noc.y}`;
        } else {
          const x = a.x + a.w * 0.88;
          d = `M${x} ${a.y + a.h}V${noc.y}`;
        }
        make(
          "path",
          {
            d,
            fill: "none",
            stroke: "#156B75",
            "stroke-width": "1",
            "stroke-dasharray": "2 4",
            opacity: "0.45",
          },
          monitors,
        );
      });
      svg.setCurrentTime(0);
      if (visible && !motion.matches) svg.unpauseAnimations();
      else svg.pauseAnimations();
    };
    new ResizeObserver(draw).observe(grid);
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (visible && !motion.matches) svg.unpauseAnimations();
      else svg.pauseAnimations();
    }).observe(root);
    motion.addEventListener("change", draw);
    document.fonts.ready.then(draw);
  });
</script>
